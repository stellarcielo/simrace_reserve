# ローカル開発時はSQLite、Vercelデプロイ時はPostgresの接続文字列を設定する
DATABASE_URL="file:./dev.db"

# 管理画面ログインパスワード
ADMIN_PASSWORD="change-me"
# セッションCookie署名用のランダムな秘密鍵（openssl rand -hex 32 などで生成）
AUTH_SECRET="change-me"

# 予約照会の隠しコードで表示する画像・GIFの直接URL（未設定なら準備中と表示）
# INMKNG → gif1、YJSNPI → gif2、MURKMR → gif3
EASTER_EGG_GIF1_URL=""
EASTER_EGG_GIF2_URL=""
EASTER_EGG_GIF3_URL=""
